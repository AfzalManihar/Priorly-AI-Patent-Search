# Copy to .env and edit. Every value has a working default, so this file is optional.

# --- Backends -------------------------------------------------------------------------------
# DENSE_BACKEND:  tfidf (offline stand-in, default) | bge (BGE embeddings in Qdrant)
# RERANK_BACKEND: lexical (offline, default)        | bge (BGE cross-encoder)
# LLM_BACKEND:    heuristic (rules, no network)     | groq (decompose, HyDE, explanations)
DENSE_BACKEND=tfidf
RERANK_BACKEND=lexical
LLM_BACKEND=heuristic

# --- Models and services (used by the bge and groq backends) --------------------------------
EMBED_MODEL=BAAI/bge-base-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
QDRANT_URL=:memory:
QDRANT_COLLECTION=priorly_chunks
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Data -----------------------------------------------------------------------------------
# CORPUS_PATH=backend/data/real/corpus.jsonl
# BENCHMARK_PATH=backend/data/real/benchmark.json
# DB_PATH=backend/data/priorly.db

# --- Pipeline parameters (also editable in the Pipeline settings page) -----------------------
RRF_K=60
CANDIDATES=50
RERANK_DEPTH=50
# RERANK_CACHE=on   # off = the reranker scores every pair again on every search (identical ranking, slower)
RATE_LIMIT_PER_MIN=60

# --- Operations -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# Comma separated browser origins allowed to call the API. Same-origin needs none; "*" is for local work only.
# CORS_ORIGINS=https://priorly.example.com

# Chunking strategy of the live index: claim_aware | fixed_window | sentence | recursive | whole_document.
# Changing it builds a separate vector index on the next start. eval.grid reports which one measured best.
# CHUNKING=claim_aware

# Time budgets (seconds, 0 = no limit). A step that runs out of time degrades instead of hanging, and the run says so.
# STAGE_BUDGET_S=20     decompose and HyDE: past this the rule-based or element text is used
# RERANK_BUDGET_S=45    rerank: reranks as many top candidates as fit, the rest keep fusion order
# EXPLAIN_BUDGET_S=60   explain: explanations not written in time use the template text
# COVERAGE_SCOPE=pool   pool = check claim elements against the passages retrieval surfaced; all = every passage (slow)

# Groq token budget over any rolling 24 hours (free tier is 200000). 0 = no limit.
DAILY_TOKEN_LIMIT=200000

# Rerank speed: passages per patent scored against the whole claim, and pairs per forward pass.
RERANK_CHUNKS=3
RERANK_BATCH=4
# on = also score every element against every passage during rerank (about 6x the pairs, slow on CPU).
RERANK_ELEMENTS=off
# Element evidence levels. CE values come from `python -m eval.coverage_controls` on DEV (BGE reranker).
COVERAGE_SUPPORT_CE=0.6
COVERAGE_PARTIAL_CE=0.6
COVERAGE_SUPPORT_RECALL=0.6
COVERAGE_PARTIAL_RECALL=0.3
