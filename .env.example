# Copy to .env and edit. Every value has a working default, so this file is optional.

# --- Backends -------------------------------------------------------------------------------
# DENSE_BACKEND:  tfidf (offline stand-in, default) | bge (BGE embeddings in Qdrant)
# RERANK_BACKEND: lexical (offline, default)        | bge (BGE cross-encoder)
# LLM_BACKEND:    heuristic (rules, no network)     | groq (decompose, HyDE, explanations)
DENSE_BACKEND=tfidf
RERANK_BACKEND=lexical
LLM_BACKEND=heuristic

# --- Models and services (used by the bge and groq backends) --------------------------------
EMBED_MODEL=BAAI/bge-base-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
QDRANT_URL=:memory:
QDRANT_COLLECTION=priorly_chunks
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Data -----------------------------------------------------------------------------------
# CORPUS_PATH=backend/data/real/corpus.jsonl
# BENCHMARK_PATH=backend/data/real/benchmark.json
# DB_PATH=backend/data/priorly.db

# --- Pipeline parameters (also editable in the Pipeline settings page) -----------------------
RRF_K=60
CANDIDATES=50
RERANK_DEPTH=50
RATE_LIMIT_PER_MIN=60

# --- Operations -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# Comma separated browser origins allowed to call the API. Same-origin needs none; "*" is for local work only.
# CORS_ORIGINS=https://priorly.example.com
